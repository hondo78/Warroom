# =============================================================================
# Warroom – Beispiel-Konfiguration
# -----------------------------------------------------------------------------
# Kopieren:  cp .env.example .env   und anschließend ausfüllen.
# Pflicht für einen sinnvollen Betrieb sind nur die mit [PFLICHT] markierten
# Blöcke. Alles andere ist optional – ohne läuft Warroom mit Fallbacks.
# Alle Werte lassen sich nach dem ersten Start auch in der Admin-UI
# (/admin.html) ändern, ohne die Container neu zu starten.
# =============================================================================

# -----------------------------------------------------------------------------
# [PFLICHT] PostgreSQL
# -----------------------------------------------------------------------------
# Ändere das Passwort vor dem ersten Start. DATABASE_URL muss dasselbe
# Passwort enthalten wie POSTGRES_PASSWORD.
POSTGRES_USER=warroom
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=warroom
DATABASE_URL=postgresql+asyncpg://warroom:changeme_secure_password@postgres:5432/warroom

# -----------------------------------------------------------------------------
# Redis (in der Regel unverändert lassen)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# [EMPFOHLEN] API-Key für /api/* und die IOC-Feeds
# -----------------------------------------------------------------------------
# Leer => "Open Mode": JEDER ohne Authentifizierung kann das Dashboard
# bedienen, IPs (ent-)blocken und Endpoints isolieren. Für alles außer einem
# isolierten Test-Setup einen Key setzen:
#   openssl rand -hex 32
# Das Frontend-nginx hängt diesen Key automatisch als X-API-Key an jeden
# /api/*-Request. Firewalls, die die IOC-Feeds ziehen, müssen den Header
# X-API-Key: <dieser Wert> selbst mitsenden.
WARROOM_API_KEY=

# -----------------------------------------------------------------------------
# [PFLICHT für Sophos-Central-Daten] Sophos Central API
# -----------------------------------------------------------------------------
# API-Credentials anlegen: Sophos Central > Global Settings > API Credentials
# Management > Add Credential. Client-ID/Secret hier eintragen. Die Tenant-ID
# wird automatisch erkannt, falls nicht gesetzt.
# Ohne diese Werte bleiben Alerts/Events/Endpoints leer – Syslog/NetFlow/
# Blocklist funktionieren trotzdem.
SOPHOS_CLIENT_ID=your-client-id
SOPHOS_CLIENT_SECRET=your-client-secret
# SOPHOS_TENANT_ID=

# Abfrage-Intervall der Sophos-Central-API in Sekunden.
COLLECTOR_INTERVAL=300

# -----------------------------------------------------------------------------
# GeoIP – MaxMind GeoLite2 (optional, Fallback ip-api.com)
# -----------------------------------------------------------------------------
# Für offline/zuverlässige Geolokation: kostenloses Konto unter
# https://www.maxmind.com/en/geolite2/signup anlegen und
# GeoLite2-City.mmdb + GeoLite2-ASN.mmdb nach ./geoip/ legen.
# Ohne mmdb-Dateien nutzt Warroom ip-api.com (rate-limitiert, ~45 req/min).
MAXMIND_LICENSE_KEY=

# -----------------------------------------------------------------------------
# OSINT-Anreicherung (alle optional – jeweils ohne Key wird der Provider
# übersprungen). Limits steuern nur die Kostenanzeige auf /stats.html.
# -----------------------------------------------------------------------------
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
SOPHOS_INTELIX_CLIENT_ID=
SOPHOS_INTELIX_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# KI-Agent (optional) – analysiert Logs per LLM und schlägt Blocks vor.
# Standardmäßig aus. Erwartet einen OpenAI-kompatiblen Endpoint
# (LMStudio, Ollama, vLLM, OpenAI ...). host.docker.internal zeigt auf den
# Docker-Host (für lokal laufende Modelle).
# -----------------------------------------------------------------------------
AGENT_ENABLED=false
AGENT_PROVIDER=lmstudio
AGENT_BASE_URL=http://host.docker.internal:1234/v1
AGENT_API_KEY=
AGENT_MODEL=
AGENT_INTERVAL_SECONDS=120
# Wenn true: block_ip/acknowledge-Empfehlungen werden automatisch ausgeführt.
AGENT_AUTO_EXECUTE=false
# Unabhängige Fast-Lane: Empfehlungen mit Konfidenz (%) >= Schwelle werden
# auto-ausgeführt. 101 = Fast-Lane komplett deaktivieren.
AGENT_AUTO_EXECUTE_THRESHOLD=90

# -----------------------------------------------------------------------------
# Grafana (http://localhost:3030) – Default-Login admin/admin unbedingt ändern!
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# -----------------------------------------------------------------------------
# Sonstiges
# -----------------------------------------------------------------------------
# Backend-Loglevel: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
DASHBOARD_TITLE=Warroom Security Dashboard
