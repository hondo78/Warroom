# Sophos Central API
SOPHOS_CLIENT_ID=your-client-id
SOPHOS_CLIENT_SECRET=your-client-secret

# Optional: Sophos Tenant ID (auto-detected if not set)
# SOPHOS_TENANT_ID=

# PostgreSQL
POSTGRES_USER=warroom
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=warroom
DATABASE_URL=postgresql+asyncpg://warroom:changeme_secure_password@postgres:5432/warroom

# Redis
REDIS_URL=redis://redis:6379/0

# GeoIP - MaxMind GeoLite2 (optional, uses ip-api.com as fallback)
# Register at https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# AbuseIPDB (optional, for reputation checks)
ABUSEIPDB_API_KEY=

# Collector interval in seconds
COLLECTOR_INTERVAL=300

# Backend log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Dashboard
DASHBOARD_TITLE=Warroom Security Dashboard

# API key required by the backend. If empty, the backend runs in open mode
# (logs a warning on startup). If set, the frontend nginx injects this value
# as X-API-Key header on every /api/* request — generate with:
#   openssl rand -hex 32
#
# The IOC blocklist feed (GET /ioc_IP) also requires this header. Firewalls
# must be configured to send X-API-Key when pulling the feed.
WARROOM_API_KEY=
