# =============================================================================
# Warroom – example configuration
# -----------------------------------------------------------------------------
# Copy:  cp .env.example .env   and then fill it in.
# Only the blocks marked [REQUIRED] are mandatory for meaningful operation.
# Everything else is optional – without it Warroom runs with fallbacks.
# After the first start, all values can also be changed in the admin UI
# (/admin.html) without restarting the containers.
# =============================================================================

# -----------------------------------------------------------------------------
# [REQUIRED] PostgreSQL
# -----------------------------------------------------------------------------
# Change the password before the first start. DATABASE_URL must contain the
# same password as POSTGRES_PASSWORD.
POSTGRES_USER=warroom
POSTGRES_PASSWORD=changeme_secure_password
POSTGRES_DB=warroom
DATABASE_URL=postgresql+asyncpg://warroom:changeme_secure_password@postgres:5432/warroom

# -----------------------------------------------------------------------------
# Redis (usually leave unchanged)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# [RECOMMENDED] API key for /api/* and the IOC feeds
# -----------------------------------------------------------------------------
# Empty => "open mode": ANYONE without authentication can operate the
# dashboard, (un)block IPs and isolate endpoints. For anything beyond an
# isolated test setup, set a key:
#   openssl rand -hex 32
# The frontend nginx automatically attaches this key as X-API-Key to every
# /api/* request. Firewalls that pull the IOC feeds must send the header
# X-API-Key: <this value> themselves.
WARROOM_API_KEY=

# -----------------------------------------------------------------------------
# [REQUIRED for Sophos Central data] Sophos Central API
# -----------------------------------------------------------------------------
# Create API credentials: Sophos Central > Global Settings > API Credentials
# Management > Add Credential. Enter the client ID/secret here. The tenant ID
# is detected automatically if not set.
# Without these values, alerts/events/endpoints stay empty – syslog/NetFlow/
# blocklist still work.
SOPHOS_CLIENT_ID=your-client-id
SOPHOS_CLIENT_SECRET=your-client-secret
# SOPHOS_TENANT_ID=

# Polling interval of the Sophos Central API in seconds.
COLLECTOR_INTERVAL=300

# -----------------------------------------------------------------------------
# GeoIP – MaxMind GeoLite2 (optional, fallback ip-api.com)
# -----------------------------------------------------------------------------
# For offline/reliable geolocation: create a free account at
# https://www.maxmind.com/en/geolite2/signup and place
# GeoLite2-City.mmdb + GeoLite2-ASN.mmdb into ./geoip/.
# Without the mmdb files Warroom uses ip-api.com (rate-limited, ~45 req/min).
MAXMIND_LICENSE_KEY=

# -----------------------------------------------------------------------------
# OSINT enrichment (all optional – each provider is skipped if its key is
# missing). The limits only drive the cost display on /stats.html.
# -----------------------------------------------------------------------------
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
SOPHOS_INTELIX_CLIENT_ID=
SOPHOS_INTELIX_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# AI agent (optional) – analyzes logs via an LLM and proposes blocks.
# Off by default. Expects an OpenAI-compatible endpoint
# (LMStudio, Ollama, vLLM, OpenAI ...). host.docker.internal points to the
# Docker host (for locally running models).
# -----------------------------------------------------------------------------
AGENT_ENABLED=false
AGENT_PROVIDER=lmstudio
AGENT_BASE_URL=http://host.docker.internal:1234/v1
AGENT_API_KEY=
AGENT_MODEL=
AGENT_INTERVAL_SECONDS=120
# Language for the agent's own output: LLM default prompts, the analyst chat
# replies and Telegram messages ("en" or "de"). Custom/overridden prompts are
# unaffected.
AGENT_LANGUAGE=en
# If true: non-destructive recommendations (acknowledge) are executed
# automatically. Block actions and isolate ALWAYS require human approval. The
# action is chosen purely from per-source thresholds in the prompts.
AGENT_AUTO_EXECUTE=false

# -----------------------------------------------------------------------------
# Grafana (http://localhost:3030) – be sure to change the default admin/admin!
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# Reverse proxy / sub-path: set ONLY if Grafana runs behind a proxy or under a
# sub-path (otherwise "Grafana has failed to load its application files").
# Direct access on :3030 → leave both values empty/false.
#
#   Proxy under /grafana:   GRAFANA_ROOT_URL=https://your-domain.tld/grafana/
#                           GRAFANA_SERVE_FROM_SUB_PATH=true
#   Proxy on its own (sub-)domain without a path:
#                           GRAFANA_ROOT_URL=https://grafana.your-domain.tld/
#                           GRAFANA_SERVE_FROM_SUB_PATH=false
GRAFANA_ROOT_URL=
GRAFANA_SERVE_FROM_SUB_PATH=false

# -----------------------------------------------------------------------------
# RedisInsight (Redis GUI, http://localhost:5540)
# -----------------------------------------------------------------------------
# Host port of the RedisInsight UI. The Warroom cache is already preconfigured
# as a connection named "Warroom Cache" when you open it. Runs without auth →
# expose only on a trusted network.
REDISINSIGHT_PORT=5540

# -----------------------------------------------------------------------------
# pgAdmin (PostgreSQL GUI, http://localhost:5051)
# -----------------------------------------------------------------------------
# The server "Warroom DB" is preconfigured (host/port/db/user); on the first
# connection enter POSTGRES_PASSWORD once (pgAdmin can store it). The login
# email needs a real TLD (not .local). Change the default password!
PGADMIN_PORT=5051
PGADMIN_EMAIL=admin@warroom.com
PGADMIN_PASSWORD=changeme_pgadmin

# -----------------------------------------------------------------------------
# Microsoft 365 / Entra ID / Telegram (optional)
# -----------------------------------------------------------------------------
# Most conveniently configured in the admin UI (/admin.html) and stored in the
# database (app_settings). The variables below are only start-up defaults in
# case you want to preset them via .env.
#
# M365 audit logs (Office 365 Management API, app permission ActivityFeed.Read):
#O365_TENANT_ID=
#O365_CLIENT_ID=
#O365_CLIENT_SECRET=
#
# Entra ID login blocking (Graph: Policy.ReadWrite.ConditionalAccess +
# Policy.Read.All, Entra ID P1 required; uses the O365 credentials above):
#ENTRA_BLOCK_ENABLED=false
#ENTRA_BLOCK_SYNC_INTERVAL_MINUTES=10
#ENTRA_CA_EXCLUDE_USERS=          # break-glass: UPN(s) or object ID(s), comma-separated
#
# Telegram approvals (bot via @BotFather):
#TELEGRAM_ENABLED=false
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Backend log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
DASHBOARD_TITLE=Warroom Security Dashboard
