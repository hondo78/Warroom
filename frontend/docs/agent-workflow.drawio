<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="warroom-agent-workflow" name="Warroom Agent Workflow (LLM)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Headline -->
        <mxCell id="title" value="Warroom — KI-Agent Workflow (LLM-basiert)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f2937" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Jede Quelle → Candidate-Filter → OSINT-Lookup → LLM (per-Source Prompt) → Decision → Auto-Execute oder Human Review" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748b" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1400" height="20" as="geometry" />
        </mxCell>

        <!-- Spalte 1 — 4 Quellen -->
        <mxCell id="srcAlert" value="&lt;b&gt;Sophos Central&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;Alerts API · agent_loop&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="srcWaf" value="&lt;b&gt;SFOS WAF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;4xx/5xx · agent_waf_loop&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="195" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="srcIps" value="&lt;b&gt;SFOS IDP / IPS&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;Intrusion · agent_ips_loop&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="srcFL" value="&lt;b&gt;Failed Logins&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;+ /24-Subnet-Sweep&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="60" y="345" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- Spalte 2 — Candidate-Filter -->
        <mxCell id="filter" value="&lt;b style='color:#2563eb'&gt;Candidate-Filter&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Whitelist (eigene FW-IPs)&lt;br&gt;• Private / Reserved IPs&lt;br&gt;• Cooldown (1h Block, 24h Audit)&lt;br&gt;&lt;br&gt;&lt;span style='color:#16a34a;font-size:10px'&gt;→ nur überlebende IPs weiter&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;dashed=1;dashPattern=4 2;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="290" y="195" width="200" height="180" as="geometry" />
        </mxCell>

        <!-- Spalte 3 — OSINT -->
