<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="warroom-agent-workflow" name="Warroom Agent Workflow">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Warroom KI-Agent · End-to-End-Workflow (zwei Tracks)" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#0f172a" vertex="1" parent="1">
          <mxGeometry x="450" y="20" width="800" height="30" as="geometry"/>
        </mxCell>

        <!-- ================================================================ -->
        <!-- TRACK A · SOPHOS CENTRAL ALERTS  (top row)                       -->
        <!-- ================================================================ -->
        <mxCell id="laneA" value="PFAD A · Sophos Central Alerts — LLM-Analyse" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ef4444;letterSpacing=2" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="600" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="sophos" value="&lt;b&gt;Sophos Central&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;collector.py · alerts API&lt;br&gt;→ alerts (DB)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="sched" value="&lt;b&gt;agent_loop&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;APScheduler · alle N Sek&lt;br&gt;pickt unprocessed alerts&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="170" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="llm" value="&lt;b&gt;LLM /chat/completions&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;OpenAI-kompatibel&lt;br&gt;LMStudio · Ollama · OpenAI&lt;br&gt;JSON-Mode + System-Prompt&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="parse" value="&lt;b&gt;Parse + Validate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;action ∈ allowlist&lt;br&gt;target_ip muss public sein&lt;br&gt;confidence 0–1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="710" y="90" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="eA1" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2" edge="1" parent="1" source="sophos" target="sched"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eA2" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2" edge="1" parent="1" source="sched" target="llm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eA3" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2" edge="1" parent="1" source="llm" target="parse"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ================================================================ -->
        <!-- TRACK B · RULE-BASED EVENTS (WAF + IPS + Failed-Login)            -->
        <!-- ================================================================ -->
        <mxCell id="laneB" value="PFAD B · Regel-basiert — WAF / IPS / Failed-Login" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#ef4444;letterSpacing=2" vertex="1" parent="1">
          <mxGeometry x="40" y="225" width="600" height="20" as="geometry"/>
        </mxCell>

        <!-- Three event sources -->
        <mxCell id="srcWaf" value="&lt;b&gt;SFOS WAF&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;agent_waf_loop&lt;br&gt;HTTP 4xx/5xx&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="srcIps" value="&lt;b&gt;SFOS IDP / IPS&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;agent_ips_loop&lt;br&gt;Intrusion-Hits&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="srcFL" value="&lt;b&gt;Failed Logins&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;agent_failed_login_loop&lt;br&gt;Brute-Force-Erkennung&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="170" height="55" as="geometry"/>
        </mxCell>

        <!-- Shared rule engine -->
        <mxCell id="ruleEng" value="&lt;b&gt;Shared Rule-Engine&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;_filter_candidates()&lt;br&gt;whitelist · privat · cooldown&lt;br&gt;_rule_block_or_audit()&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;dashed=1;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="240" y="290" width="190" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ruleThr" value="&lt;b&gt;Severity-high&lt;/b&gt;&lt;br&gt;ODER&lt;br&gt;&lt;b&gt;Hits/24h ≥ N&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="470" y="305" width="180" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="osint" value="&lt;b&gt;OSINT-Reputation&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;AbuseIPDB ≥ 75&lt;br&gt;VT malicious ≥ 2&lt;br&gt;GreyNoise=malicious&lt;br&gt;Intelix ≥ 70&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="470" y="430" width="180" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="recBlock" value="&lt;b&gt;block_ip&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;conf 0.92 (Severity)&lt;br&gt;conf 0.95 (Threshold)&lt;br&gt;conf 0.85 (OSINT)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="710" y="310" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="noAction" value="&lt;b&gt;no_action (audit)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;wird gespeichert · 24h cooldown&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="710" y="465" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="eBSrcWaf" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2" edge="1" parent="1" source="srcWaf" target="ruleEng"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eBSrcIps" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2" edge="1" parent="1" source="srcIps" target="ruleEng"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eBSrcFL" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2" edge="1" parent="1" source="srcFL" target="ruleEng"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eB2" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2" edge="1" parent="1" source="ruleEng" target="ruleThr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eB3" value="ja" style="endArrow=classic;html=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#dc2626" edge="1" parent="1" source="ruleThr" target="recBlock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eB4" value="nein" style="endArrow=classic;html=1;strokeColor=#8b5cf6;strokeWidth=2;fontColor=#7c3aed" edge="1" parent="1" source="ruleThr" target="osint"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eB5" value="bad reputation" style="endArrow=classic;html=1;strokeColor=#ef4444;strokeWidth=2;fontColor=#dc2626" edge="1" parent="1" source="osint" target="recBlock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eB6" value="unauffällig" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2;dashed=1;fontColor=#475569" edge="1" parent="1" source="osint" target="noAction"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ================================================================ -->
        <!-- WHITELIST-GATE (shared safety check)                              -->
        <!-- ================================================================ -->
        <mxCell id="whitelist" value="&lt;b&gt;🛡 Whitelist-Gate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;eigene Firewall-IPs&lt;br&gt;niemals blockierbar&lt;br&gt;HARD GUARD vor jedem block_ip&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=3;dashed=1;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="950" y="200" width="220" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="eWL1" style="endArrow=classic;html=1;strokeColor=#22c55e;strokeWidth=2" edge="1" parent="1" source="parse" target="whitelist"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eWL2" style="endArrow=classic;html=1;strokeColor=#22c55e;strokeWidth=2" edge="1" parent="1" source="recBlock" target="whitelist"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ================================================================ -->
        <!-- AGENT_DECISIONS (central DB) -->
        <!-- ================================================================ -->
        <mxCell id="ad" value="&lt;b&gt;agent_decisions (DB)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;source_type · decided_by · action · args&lt;br&gt;reasoning · confidence · supersedes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=3;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="950" y="370" width="280" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="eAD1" style="endArrow=classic;html=1;strokeColor=#22c55e;strokeWidth=2" edge="1" parent="1" source="whitelist" target="ad"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eAD2" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2;dashed=1" edge="1" parent="1" source="noAction" target="ad"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- ================================================================ -->
        <!-- AUTO/HUMAN BRANCH + OUTCOMES                                      -->
        <!-- ================================================================ -->
        <mxCell id="branch" value="&lt;b&gt;agent_auto_execute &amp;&amp;&lt;br&gt;safe action?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="990" y="500" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="auto" value="&lt;b&gt;Auto-Execute&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;nur block_ip · acknowledge&lt;br&gt;isolate bleibt manuell&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1280" y="510" width="170" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="review" value="&lt;b&gt;/agent.html · Pending&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;Human-in-the-loop&lt;br&gt;Detail-Modal · Approve / Reject / Override&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="730" y="510" width="220" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="eBr1" style="endArrow=classic;html=1;strokeColor=#475569;strokeWidth=2" edge="1" parent="1" source="ad" target="branch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eBr2" value="ja" style="endArrow=classic;html=1;strokeColor=#22c55e;strokeWidth=2;fontColor=#16a34a" edge="1" parent="1" source="branch" target="auto"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eBr3" value="nein" style="endArrow=classic;html=1;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ea580c" edge="1" parent="1" source="branch" target="review"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Human actions row -->
        <mxCell id="approve" value="&lt;b&gt;✓ Approve&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;execute_decision()&lt;br&gt;+ human_comment&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="500" y="640" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="reject" value="&lt;b&gt;✗ Reject&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;status = rejected&lt;br&gt;+ human_comment&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="690" y="640" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="override" value="&lt;b&gt;↻ Override&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;neue Decision: decided_by=human&lt;br&gt;alte → superseded&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="880" y="640" width="200" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="eRev1" style="endArrow=classic;html=1;strokeColor=#22c55e;strokeWidth=2" edge="1" parent="1" source="review" target="approve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRev2" style="endArrow=classic;html=1;strokeColor=#64748b;strokeWidth=2" edge="1" parent="1" source="review" target="reject"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eRev3" style="endArrow=classic;html=1;strokeColor=#3b82f6;strokeWidth=2" edge="1" parent="1" source="review" target="override"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Final outcomes -->
        <mxCell id="blockip" value="&lt;b&gt;blocked_ips (DB)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;sofort live im IOC-Feed&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="500" y="780" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="iocfeed" value="&lt;b&gt;GET /ioc_IP&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;text/plain Feed&lt;br&gt;Firewall pulled live&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="750" y="780" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ack" value="&lt;b&gt;Sophos Central&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;Alarm acknowledged&lt;br&gt;(nur Track A)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=2;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="950" y="780" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="eOut1" style="endArrow=classic;html=1;strokeColor=#ef4444;strokeWidth=2" edge="1" parent="1" source="approve" target="blockip"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eOut2" style="endArrow=classic;html=1;strokeColor=#3b82f6;strokeWidth=2" edge="1" parent="1" source="approve" target="ack"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eOut3" style="endArrow=classic;html=1;strokeColor=#ef4444;strokeWidth=2" edge="1" parent="1" source="override" target="blockip"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eOut4" style="endArrow=classic;html=1;strokeColor=#ef4444;strokeWidth=2" edge="1" parent="1" source="auto" target="iocfeed"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eOut5" style="endArrow=classic;html=1;strokeColor=#ef4444;strokeWidth=2" edge="1" parent="1" source="blockip" target="iocfeed"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Audit trail across bottom -->
        <mxCell id="audit" value="&lt;b&gt;Audit-Trail · agent_decisions Tabelle&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#64748b'&gt;jede Aktion (Agent oder Mensch, Alert oder WAF) erzeugt eine Zeile · supersedes-Chain · ablesbar in /agent.html&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;strokeWidth=2;fontSize=12;dashed=1" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1620" height="60" as="geometry"/>
        </mxCell>

      </root>
