    {
      "id": 17,
      "type": "table",
      "title": "Top-Flows (5-Tuple)",
      "datasource": {
        "type": "postgres",
        "uid": "warroom-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT src_ip AS \"Quell-IP\", dst_ip AS \"Ziel-IP\", dst_port AS \"Port\", CASE protocol WHEN 1 THEN 'ICMP' WHEN 6 THEN 'TCP' WHEN 17 THEN 'UDP' WHEN 47 THEN 'GRE' WHEN 50 THEN 'ESP' WHEN 51 THEN 'AH' WHEN 58 THEN 'ICMPv6' ELSE 'P' || protocol::text END AS \"Proto\", CASE dst_port WHEN 20 THEN 'ftp-data' WHEN 21 THEN 'ftp' WHEN 22 THEN 'ssh' WHEN 23 THEN 'telnet' WHEN 25 THEN 'smtp' WHEN 53 THEN 'dns' WHEN 80 THEN 'http' WHEN 110 THEN 'pop3' WHEN 123 THEN 'ntp' WHEN 143 THEN 'imap' WHEN 161 THEN 'snmp' WHEN 389 THEN 'ldap' WHEN 443 THEN 'https' WHEN 445 THEN 'smb' WHEN 465 THEN 'smtps' WHEN 514 THEN 'syslog' WHEN 587 THEN 'submission' WHEN 636 THEN 'ldaps' WHEN 993 THEN 'imaps' WHEN 995 THEN 'pop3s' WHEN 1433 THEN 'mssql' WHEN 3306 THEN 'mysql' WHEN 3389 THEN 'rdp' WHEN 5432 THEN 'postgres' WHEN 5900 THEN 'vnc' WHEN 6379 THEN 'redis' WHEN 8080 THEN 'http-alt' WHEN 8443 THEN 'https-alt' WHEN 27017 THEN 'mongodb' ELSE 'port-' || dst_port::text END AS \"Service\", SUM(bytes) AS \"Bytes\", SUM(packets) AS \"Pakete\", SUM(flows) AS \"Flows\" FROM netflow_buckets WHERE $__timeFilter(bucket_start) AND src_ip IS NOT NULL AND dst_ip IS NOT NULL AND firewall_ip IN (${firewall:sqlstring}) GROUP BY src_ip, dst_ip, dst_port, protocol ORDER BY \"Bytes\" DESC LIMIT 200"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
