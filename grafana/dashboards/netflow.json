    {
      "id": 16,
      "type": "table",
      "title": "Interface-Auslastung",
      "datasource": {
        "type": "postgres",
        "uid": "warroom-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT firewall_ip AS \"Firewall\", iface_idx AS \"Iface\", COALESCE(SUM(bytes) FILTER (WHERE direction = 'in'), 0) AS \"Bytes Ingress\", COALESCE(SUM(bytes) FILTER (WHERE direction = 'out'), 0) AS \"Bytes Egress\", COALESCE(SUM(flows) FILTER (WHERE direction = 'in'), 0) AS \"Flows In\", COALESCE(SUM(flows) FILTER (WHERE direction = 'out'), 0) AS \"Flows Out\", ROUND(COALESCE(SUM(bytes) FILTER (WHERE direction = 'in'), 0) * 8.0 /   NULLIF(EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)), 0) / 1000000, 3) AS \"\u00d8 Mbps In\", ROUND(COALESCE(SUM(bytes) FILTER (WHERE direction = 'out'), 0) * 8.0 /   NULLIF(EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)), 0) / 1000000, 3) AS \"\u00d8 Mbps Out\" FROM netflow_iface_buckets WHERE $__timeFilter(bucket_start) AND firewall_ip IN (${firewall:sqlstring}) GROUP BY firewall_ip, iface_idx ORDER BY (COALESCE(SUM(bytes) FILTER (WHERE direction = 'in'), 0) + COALESCE(SUM(bytes) FILTER (WHERE direction = 'out'), 0)) DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        },
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "color": {
            "mode": "thresholds"
          }
        },
