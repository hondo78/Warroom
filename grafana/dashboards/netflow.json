    {
      "id": 15,
      "type": "geomap",
      "title": "Destination-Karte \u2014 wo gehen die Bytes hin",
      "datasource": {
        "type": "postgres",
        "uid": "warroom-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT g.lat AS latitude, g.lon AS longitude,\n       MAX(g.country) AS \"Land\",\n       MAX(g.city) AS \"Stadt\",\n       MAX(g.org) AS \"Organisation\",\n       MAX(g.asn) AS \"ASN\",\n       COUNT(DISTINCT nb.dst_ip) AS \"Unique Ziel-IPs\",\n       pg_size_pretty(SUM(nb.bytes)::bigint) AS \"Volumen\",\n       SUM(nb.packets) AS \"Pakete\",\n       SUM(nb.flows) AS \"Flows\",\n       array_to_string((array_agg(DISTINCT nb.dst_ip ORDER BY nb.dst_ip) FILTER (WHERE nb.dst_ip IS NOT NULL))[1:5], ', ') AS \"Top Ziel-IPs\",\n       array_to_string((array_agg(DISTINCT nb.src_ip ORDER BY nb.src_ip) FILTER (WHERE nb.src_ip IS NOT NULL))[1:5], ', ') AS \"Quell-IPs (intern)\",\n       array_to_string((array_agg(DISTINCT CASE nb.dst_port WHEN 20 THEN 'ftp-data' WHEN 21 THEN 'ftp' WHEN 22 THEN 'ssh' WHEN 23 THEN 'telnet' WHEN 25 THEN 'smtp' WHEN 53 THEN 'dns' WHEN 80 THEN 'http' WHEN 110 THEN 'pop3' WHEN 123 THEN 'ntp' WHEN 143 THEN 'imap' WHEN 161 THEN 'snmp' WHEN 389 THEN 'ldap' WHEN 443 THEN 'https' WHEN 445 THEN 'smb' WHEN 465 THEN 'smtps' WHEN 514 THEN 'syslog' WHEN 587 THEN 'submission' WHEN 636 THEN 'ldaps' WHEN 993 THEN 'imaps' WHEN 995 THEN 'pop3s' WHEN 1433 THEN 'mssql' WHEN 3306 THEN 'mysql' WHEN 3389 THEN 'rdp' WHEN 5432 THEN 'postgres' WHEN 5900 THEN 'vnc' WHEN 6379 THEN 'redis' WHEN 8080 THEN 'http-alt' WHEN 8443 THEN 'https-alt' WHEN 27017 THEN 'mongodb' ELSE 'port-' || nb.dst_port::text END) FILTER (WHERE nb.dst_port IS NOT NULL))[1:5], ', ') AS \"Top Services\",\n       array_to_string((array_agg(DISTINCT CASE nb.protocol WHEN 1 THEN 'ICMP' WHEN 6 THEN 'TCP' WHEN 17 THEN 'UDP' WHEN 47 THEN 'GRE' WHEN 50 THEN 'ESP' WHEN 51 THEN 'AH' WHEN 58 THEN 'ICMPv6' ELSE 'P' || nb.protocol::text END) FILTER (WHERE nb.protocol IS NOT NULL))[1:5], ', ') AS \"Protokolle\",\n       MIN(nb.bucket_start) AS \"Erster Flow\",\n       MAX(nb.bucket_start) AS \"Letzter Flow\",\n       SUM(nb.bytes) AS \"Bytes\"\nFROM netflow_buckets nb\nJOIN geoip_cache g ON g.ip = nb.dst_ip\nWHERE $__timeFilter(nb.bucket_start)\n  AND g.lat IS NOT NULL\n  AND nb.firewall_ip IN (${firewall:sqlstring})\nGROUP BY g.lat, g.lon\nORDER BY SUM(nb.bytes) DESC\nLIMIT 300"
        }
      ],
