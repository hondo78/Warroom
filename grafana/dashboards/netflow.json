    {
      "id": 13,
      "type": "barchart",
      "title": "Top-Ports / Services",
      "datasource": {
        "type": "postgres",
        "uid": "warroom-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT CASE dst_port WHEN 20 THEN 'ftp-data' WHEN 21 THEN 'ftp' WHEN 22 THEN 'ssh' WHEN 23 THEN 'telnet' WHEN 25 THEN 'smtp' WHEN 53 THEN 'dns' WHEN 80 THEN 'http' WHEN 110 THEN 'pop3' WHEN 123 THEN 'ntp' WHEN 143 THEN 'imap' WHEN 161 THEN 'snmp' WHEN 389 THEN 'ldap' WHEN 443 THEN 'https' WHEN 445 THEN 'smb' WHEN 465 THEN 'smtps' WHEN 514 THEN 'syslog' WHEN 587 THEN 'submission' WHEN 636 THEN 'ldaps' WHEN 993 THEN 'imaps' WHEN 995 THEN 'pop3s' WHEN 1433 THEN 'mssql' WHEN 3306 THEN 'mysql' WHEN 3389 THEN 'rdp' WHEN 5432 THEN 'postgres' WHEN 5900 THEN 'vnc' WHEN 6379 THEN 'redis' WHEN 8080 THEN 'http-alt' WHEN 8443 THEN 'https-alt' WHEN 27017 THEN 'mongodb' ELSE 'port-' || dst_port::text END AS service, SUM(bytes) AS bytes FROM netflow_buckets WHERE $__timeFilter(bucket_start) AND dst_port IS NOT NULL AND firewall_ip IN (${firewall:sqlstring}) GROUP BY dst_port ORDER BY bytes DESC LIMIT 15"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "legend": {
