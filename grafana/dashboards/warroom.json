          "rawSql": "SELECT fl.created_at AS time,\n       fl.attacker_lat AS latitude, fl.attacker_lon AS longitude,\n       fl.source_ip AS \"Quell-IP\",\n       fl.destination_ip AS \"Ziel-IP\",\n       fl.log_type AS \"Art\",\n       fl.severity AS \"Schwere\",\n       fl.attacker_country AS \"Land\",\n       fl.attacker_city AS \"Stadt\",\n       fl.threat_name AS \"Threat\",\n       fl.firewall_name AS \"Firewall\"\nFROM firewall_logs fl\nWHERE $__timeFilter(fl.created_at)\n  AND fl.attacker_lat IS NOT NULL\n  AND fl.source_ip IS NOT NULL\n  AND fl.destination_ip IS NOT NULL\n  AND fl.log_type IN (${attack_type:sqlstring})\n AND (EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - fl.created_at)) / NULLIF(EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)), 0)) > 0.3333333333333333 AND (EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - fl.created_at)) / NULLIF(EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)), 0)) <= 0.5\nORDER BY fl.created_at DESC\nLIMIT 150"
