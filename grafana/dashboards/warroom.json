    {
      "id": 13,
      "type": "geomap",
      "title": "Angriffe \u2014 6 Fade-Stufen \u00fcber den Dashboard-Zeitraum",
      "datasource": {
        "type": "postgres",
        "uid": "warroom-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A1",
          "format": "table",
          "rawSql": "SELECT fl.created_at AS time,\n       fl.attacker_lat AS latitude, fl.attacker_lon AS longitude,\n       fl.source_ip AS \"Quell-IP\",\n       fl.destination_ip AS \"Ziel-IP\",\n       fl.log_type AS \"Art\",\n       fl.severity AS \"Schwere\",\n       fl.attacker_country AS \"Land\",\n       fl.attacker_city AS \"Stadt\",\n       fl.threat_name AS \"Threat\",\n       fl.firewall_name AS \"Firewall\"\nFROM firewall_logs fl\nWHERE $__timeFilter(fl.created_at)\n  AND fl.attacker_lat IS NOT NULL\n  AND fl.source_ip IS NOT NULL\n  AND fl.destination_ip IS NOT NULL\n  AND fl.log_type IN (${attack_type:sqlstring})\n AND (EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - fl.created_at)) / NULLIF(EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)), 0)) > 0.0 AND (EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - fl.created_at)) / NULLIF(EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)), 0)) <= 0.16666666666666666\nORDER BY fl.created_at DESC\nLIMIT 150"
        },
        {
          "refId": "A2",
          "format": "table",
          "rawSql": "SELECT fl.created_at AS time,\n       fl.attacker_lat AS latitude, fl.attacker_lon AS longitude,\n       fl.source_ip AS \"Quell-IP\",\n       fl.destination_ip AS \"Ziel-IP\",\n       fl.log_type AS \"Art\",\n       fl.severity AS \"Schwere\",\n       fl.attacker_country AS \"Land\",\n       fl.attacker_city AS \"Stadt\",\n       fl.threat_name AS \"Threat\",\n       fl.firewall_name AS \"Firewall\"\nFROM firewall_logs fl\nWHERE $__timeFilter(fl.created_at)\n  AND fl.attacker_lat IS NOT NULL\n  AND fl.source_ip IS NOT NULL\n  AND fl.destination_ip IS NOT NULL\n  AND fl.log_type IN (${attack_type:sqlstring})\n AND (EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - fl.created_at)) / NULLIF(EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)), 0)) > 0.16666666666666666 AND (EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - fl.created_at)) / NULLIF(EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)), 0)) <= 0.3333333333333333\nORDER BY fl.created_at DESC\nLIMIT 150"
        },
