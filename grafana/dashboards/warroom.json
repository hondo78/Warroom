        "query": "SELECT (CASE\n  WHEN sec >= 172800 THEN ROUND((sec/86400)::numeric, 1)::text || 'd'\n  WHEN sec >= 3600 THEN ROUND((sec/3600)::numeric, 1)::text || 'h'\n  WHEN sec >= 60 THEN GREATEST(1, ROUND((sec/60)::numeric))::text || 'min'\n  ELSE GREATEST(1, ROUND(sec::numeric))::text || 's'\nEND) AS label\nFROM (\n  SELECT EXTRACT(EPOCH FROM ($__timeTo()::timestamptz - $__timeFrom()::timestamptz)) * 1.0 / 6.0 AS sec\n) t",
