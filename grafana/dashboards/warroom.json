      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(bucket_start, $__interval) AS time, COALESCE(SUM(bytes), 0) AS \"Bytes\" FROM netflow_buckets WHERE $__timeFilter(bucket_start) GROUP BY 1 ORDER BY 1"
