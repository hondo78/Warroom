        {
          "refId": "A",
          "format": "table",
          "rawSql": "WITH failed AS (SELECT source_ip, created_at, user_name, attacker_country FROM firewall_logs WHERE created_at >= NOW() - INTERVAL '7 days' AND source_ip IS NOT NULL AND (log_type IN ('Authentication', 'Event') OR (raw_data->>'log_component') ILIKE ANY (ARRAY['%auth%','%admin%','%ssl vpn%','%ipsec%'])) AND ((raw_data->>'status') ILIKE 'fail%' OR (raw_data->>'auth_status') ILIKE 'fail%' OR COALESCE(message,'') ILIKE '%fail%' OR COALESCE(message,'') ILIKE '%denied%')) SELECT source_ip AS \"Quell-IP\", COUNT(*) AS \"Versuche\", COUNT(*) FILTER (WHERE created_at >= NOW() - INTERVAL '24 hours') AS \"24h\", MAX(created_at) AS \"Letzter\", MAX(attacker_country) AS \"Land\" FROM failed GROUP BY source_ip ORDER BY 2 DESC LIMIT 50"
