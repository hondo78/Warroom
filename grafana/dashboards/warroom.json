          "rawSql": "SELECT n.src_ip AS \"Source-IP\", SUM(n.bytes) AS \"Bytes\", SUM(n.flows) AS \"Flows\", MAX(g.country) AS \"Land\" FROM netflow_buckets n LEFT JOIN geoip_cache g ON g.ip = n.src_ip WHERE $__timeFilter(n.bucket_start) AND n.src_ip IS NOT NULL GROUP BY n.src_ip ORDER BY 2 DESC LIMIT 25"
