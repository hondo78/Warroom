          "refId": "B",
          "format": "table",
          "rawSql": "WITH attacks AS (\n  SELECT ROW_NUMBER() OVER (ORDER BY fl.created_at DESC) AS rn,\n         fl.attacker_lat AS att_lat, fl.attacker_lon AS att_lon,\n         COALESCE(floc.lat, (SELECT lat FROM firewall_locations LIMIT 1)) AS fw_lat,\n         COALESCE(floc.lon, (SELECT lon FROM firewall_locations LIMIT 1)) AS fw_lon\n  FROM firewall_logs fl\n  LEFT JOIN firewall_locations floc ON floc.ip = fl.firewall_ip OR floc.name = fl.firewall_name\n  WHERE $__timeFilter(fl.created_at)\n    AND fl.attacker_lat IS NOT NULL\n    AND fl.source_ip IS NOT NULL\n    AND fl.destination_ip IS NOT NULL\n    AND fl.log_type IN (${attack_type:sqlstring})\n  ORDER BY fl.created_at DESC\n  LIMIT 500\n)\nSELECT (rn - 1) * 2 AS step, att_lat AS latitude, att_lon AS longitude FROM attacks WHERE att_lat IS NOT NULL\nUNION ALL\nSELECT (rn - 1) * 2 + 1, fw_lat, fw_lon FROM attacks WHERE fw_lat IS NOT NULL\nORDER BY step"
        },
        {
          "refId": "C",
          "format": "table",
          "rawSql": "SELECT lat AS latitude, lon AS longitude, name AS \"Firewall\", ip AS \"IP\", country AS \"Land\", city AS \"Stadt\"\nFROM firewall_locations"
        }
      ],
